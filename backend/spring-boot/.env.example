# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - it's ignored in .gitignore

PORT=8080
BASE_ROUTE=/api

# MongoDB Connection String
# Get this from your MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&appName=AppName
MONGODB_CREATION=true

# File Upload Limits
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=100MB

# Date/Time Settings
TIMESTAMPS=false
TIME_ZONE=UTC

# Logging Levels (TRACE, DEBUG, INFO, WARN, ERROR)
SPRING_LOGGING_LEVEL=INFO
APP_LOGGING_LEVEL=DEBUG

# CORS Configuration (comma-separated for multiple origins)
cors.allowed-origins=http://localhost:3000
