# ============================================
# BACKEND API CONFIGURATION (IMPORTANT)
# ============================================

# Spring Boot Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Backend connection timeout
BACKEND_TIMEOUT=30000

# ============================================
# SPRING BOOT - MongoDB CONFIGURATION
# ============================================
# NOTE: These go in your Spring Boot application.properties, NOT here!
# MONGODB_URI=mongodb+srv://tarcom_user:PASSWORD@cluster0.xxxxx.mongodb.net/tarcom?retryWrites=true&w=majority

# ============================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================

# Gmail example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-app

# Email addresses for notifications
EMAIL_FROM=noreply@tarcom.fr
COMPANY_EMAIL=admin@tarcom.fr

# ============================================
# API CONFIGURATION
# ============================================

# Frontend URL
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# File upload limits
MAX_FILE_SIZE=10485760

# ============================================
# DEVELOPMENT
# ============================================

# Set to 'development' for logs
NODE_ENV=development
